rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur ne peut lire/écrire que son propre profil.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fiche véhicule d'un chauffeur (assistant d'inscription en 3 étapes,
    // solde du portefeuille) : lisible par tout utilisateur connecté (un
    // client mis en relation doit voir le modèle/la plaque du véhicule),
    // mais modifiable uniquement par le chauffeur lui-même.
    match /driver_profiles/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == driverId;
    }

    // Demandes de course : tout utilisateur connecté peut lire (un chauffeur
    // doit voir les demandes en recherche), mais l'écriture est restreinte
    // selon qui on est et l'état de transition demandé.
    match /ride_requests/{requestId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.status == 'searching';

      allow update: if request.auth != null && (
        // le client annule sa propre demande tant qu'elle cherche un chauffeur
        (resource.data.clientUid == request.auth.uid
          && resource.data.status == 'searching'
          && request.resource.data.status == 'cancelled')
        ||
        // un chauffeur accepte une demande encore ouverte
        (resource.data.status == 'searching'
          && request.resource.data.status == 'accepted'
          && request.resource.data.driverUid == request.auth.uid)
        ||
        // le chauffeur assigné termine ou annule la course acceptée
        (resource.data.status == 'accepted'
          && resource.data.driverUid == request.auth.uid
          && request.resource.data.status in ['completed', 'cancelled'])
        ||
        // le client note le chauffeur une fois la course terminée
        (resource.data.status == 'completed'
          && resource.data.clientUid == request.auth.uid
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['rating', 'ratingComment', 'ratingPunctuality', 'ratingDriving', 'ratingCourtesy', 'ratingCleanliness']
          ))
      );

      allow delete: if false;

      // Messages échangés entre le client et le chauffeur assigné à cette
      // course : lisibles/écrivables uniquement par ces deux personnes.
      function isRideParty() {
        return get(/databases/$(database)/documents/ride_requests/$(requestId)).data.clientUid == request.auth.uid
          || get(/databases/$(database)/documents/ride_requests/$(requestId)).data.driverUid == request.auth.uid;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null && isRideParty();
        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && isRideParty();
        allow update, delete: if false;
      }
    }
  }
}
