rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur ne peut lire/écrire que son propre profil. Un
    // changement de `activeMode` (bascule client/chauffeur, voir
    // ProfilScreen) est en plus soumis à ce qu'aucune course ne soit active
    // dans le mode qu'on quitte — clientActiveRideId/driverActiveRideId sont
    // tenus à jour par l'app aux points de transition d'une course (voir
    // booking_screen.dart / driver_home_screen.dart). Ça bloque les bascules
    // accidentelles/bugs UI, pas un client qui bricolerait ces deux champs à
    // la main via une requête Firestore brute — un blindage complet
    // demanderait une Cloud Function, hors scope ici (cohérent avec le
    // reste de ce fichier, qui fait déjà confiance à des invariants basés
    // sur `diff().affectedKeys()` plutôt que sur des Cloud Functions).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && (
        request.resource.data.get('activeMode', null) == resource.data.get('activeMode', null)
        || (resource.data.get('activeMode', null) == 'client'
            ? resource.data.get('clientActiveRideId', null) == null
            : resource.data.get('driverActiveRideId', null) == null)
      );
      allow delete: if false;
    }

    // Fiche véhicule d'un chauffeur (assistant d'inscription en 3 étapes).
    // Le propriétaire voit toujours sa propre fiche (y compris en attente
    // de validation, avec ses documents d'identité). Les autres
    // utilisateurs connectés ne la voient que si le chauffeur est déjà
    // approuvé — une fiche encore en attente/refusée (documents, permis)
    // n'est visible que par son propriétaire et l'admin (Admin SDK, qui
    // ignore ces règles). Le chauffeur peut créer sa fiche et corriger ses
    // infos/photos, mais ne peut jamais modifier lui-même `status` — ce
    // champ ne change que via le panneau admin (validation d'inscription).
    //
    // Le solde (`wallet/current`) et la position GPS live
    // (`location/current`) vivent dans des sous-collections séparées,
    // chacune avec ses propres règles ci-dessous — pas dans ce document —
    // pour qu'ils ne soient jamais exposés au même titre que le
    // modèle/la plaque du véhicule à n'importe quel utilisateur connecté.
    match /driver_profiles/{driverId} {
      allow read: if request.auth != null && (
        request.auth.uid == driverId || resource.data.status == 'approved'
      );

      allow create: if request.auth != null && request.auth.uid == driverId
        && request.resource.data.status == 'pending_verification';

      allow update: if request.auth != null && request.auth.uid == driverId
        && request.resource.data.status == resource.data.status;

      allow delete: if false;

      // Solde du portefeuille : jamais lisible ni modifiable par qui que
      // ce soit d'autre que le chauffeur propriétaire (en lecture), et par
      // le chauffeur lui-même seulement à la création (initialisée à 0).
      // Toute recharge passe ensuite exclusivement par le panneau admin
      // (Firebase Admin SDK, qui ignore ces règles) — plus aucune écriture
      // cliente possible une fois le document créé.
      match /wallet/{docId} {
        allow read: if request.auth != null && request.auth.uid == driverId;
        allow create: if request.auth != null && request.auth.uid == driverId
          && request.resource.data.balance == 0;
        allow update, delete: if false;
      }

      // Position GPS live : modifiable uniquement par le chauffeur
      // propriétaire (diffusion en continu pendant qu'il est en ligne).
      // Lisible par lui-même, ou par le client actuellement mis en
      // relation avec lui — `activeClientUid` est posé par le chauffeur
      // au moment où il accepte une course et effacé à la fin de celle-ci
      // (voir `driver_home_screen.dart`). Filet de sécurité en plus de cet
      // effacement explicite : l'accès expire de lui-même 2h après la
      // dernière mise à jour GPS (`updatedAt`), au cas où l'app du
      // chauffeur se ferme brutalement en pleine course sans repasser par
      // le nettoyage normal — jamais un accès qui reste ouvert indéfiniment.
      match /location/{docId} {
        allow read: if request.auth != null && (
          request.auth.uid == driverId ||
          (resource != null
            && resource.data.get('activeClientUid', null) == request.auth.uid
            && resource.data.get('updatedAt', null) != null
            && request.time < resource.data.updatedAt + duration.value(2, 'h'))
        );
        allow write: if request.auth != null && request.auth.uid == driverId;
      }

      // Documents d'identité (carte grise, permis, photos du véhicule) :
      // jamais lisibles ni modifiables par personne d'autre que le
      // chauffeur propriétaire — contrairement au reste de la fiche
      // (modèle/plaque), ces documents ne sont jamais publics même une
      // fois le chauffeur approuvé. L'admin y accède via Admin SDK.
      match /documents/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == driverId;
      }
    }

    // Demandes de course : un chauffeur doit pouvoir parcourir les demandes
    // encore ouvertes ('searching') pour les accepter ; en dehors de ça,
    // un client/chauffeur ne voit que ses propres courses, une fois qu'il y
    // est partie prenante (clientUid ou driverUid). Ce n'est pas un filtre
    // appliqué après coup : Firestore rejette toute requête qui ne
    // contraint pas déjà `status`/`clientUid`/`driverUid` de façon à
    // garantir que chaque résultat respecte l'une de ces trois conditions —
    // une requête "toute la collection" est donc refusée.
    match /ride_requests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.status == 'searching' ||
        resource.data.clientUid == request.auth.uid ||
        resource.data.driverUid == request.auth.uid
      );

      allow create: if request.auth != null
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.status == 'searching';

      allow update: if request.auth != null && (
        // le client annule sa propre demande tant qu'elle cherche un chauffeur
        (resource.data.clientUid == request.auth.uid
          && resource.data.status == 'searching'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        ||
        // un chauffeur accepte une demande encore ouverte
        (resource.data.status == 'searching'
          && request.resource.data.status == 'accepted'
          && request.resource.data.driverUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'driverUid', 'driverName']))
        ||
        // le chauffeur assigné termine ou annule la course acceptée
        (resource.data.status == 'accepted'
          && resource.data.driverUid == request.auth.uid
          && request.resource.data.status in ['completed', 'cancelled']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        ||
        // le client note le chauffeur une fois la course terminée
        (resource.data.status == 'completed'
          && resource.data.clientUid == request.auth.uid
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['rating', 'ratingComment', 'ratingPunctuality', 'ratingDriving', 'ratingCourtesy', 'ratingCleanliness']
          ))
        ||
        // le client paie sa course une fois celle-ci terminée
        (resource.data.status == 'completed'
          && resource.data.clientUid == request.auth.uid
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['paymentStatus', 'paymentMethod', 'paymentAmount', 'paymentDriverId']
          ))
      );

      allow delete: if false;

      // Messages échangés entre le client et le chauffeur assigné à cette
      // course : lisibles/écrivables uniquement par ces deux personnes.
      function isRideParty() {
        return get(/databases/$(database)/documents/ride_requests/$(requestId)).data.clientUid == request.auth.uid
          || get(/databases/$(database)/documents/ride_requests/$(requestId)).data.driverUid == request.auth.uid;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null && isRideParty();
        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && isRideParty();
        allow update, delete: if false;
      }
    }

    // Signalements (incidents/avis) envoyés par un client ou un chauffeur
    // depuis l'appli — traités uniquement côté admin (Admin SDK, qui
    // ignore ces règles). Un utilisateur ne voit que ses propres
    // signalements et ne peut jamais les modifier une fois envoyés.
    match /incidents/{incidentId} {
      allow read: if request.auth != null && resource.data.reporterUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open';

      allow update, delete: if false;
    }
  }
}
