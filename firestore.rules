rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur ne peut lire/écrire que son propre profil.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fiche véhicule d'un chauffeur (assistant d'inscription en 3 étapes,
    // solde du portefeuille, position GPS live). Le propriétaire voit
    // toujours sa propre fiche (y compris en attente de validation, avec
    // ses documents d'identité). Les autres utilisateurs connectés ne la
    // voient que si le chauffeur est déjà approuvé — une fiche encore en
    // attente/refusée (documents, permis) n'est visible que par son
    // propriétaire et l'admin (Admin SDK, qui ignore ces règles).
    // Le chauffeur peut créer sa fiche et corriger ses infos/photos, mais
    // ne peut jamais modifier lui-même `status` ou `balance` — ces deux
    // champs ne changent que via le panneau admin (Firebase Admin SDK,
    // qui ignore ces règles) : validation d'inscription et recharge de
    // solde.
    match /driver_profiles/{driverId} {
      allow read: if request.auth != null && (
        request.auth.uid == driverId || resource.data.status == 'approved'
      );

      allow create: if request.auth != null && request.auth.uid == driverId
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.balance == 0;

      allow update: if request.auth != null && request.auth.uid == driverId
        && request.resource.data.status == resource.data.status
        && request.resource.data.balance == resource.data.balance;

      allow delete: if false;
    }

    // Demandes de course : un chauffeur doit pouvoir parcourir les demandes
    // encore ouvertes ('searching') pour les accepter ; en dehors de ça,
    // un client/chauffeur ne voit que ses propres courses, une fois qu'il y
    // est partie prenante (clientUid ou driverUid). Ce n'est pas un filtre
    // appliqué après coup : Firestore rejette toute requête qui ne
    // contraint pas déjà `status`/`clientUid`/`driverUid` de façon à
    // garantir que chaque résultat respecte l'une de ces trois conditions —
    // une requête "toute la collection" est donc refusée.
    match /ride_requests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.status == 'searching' ||
        resource.data.clientUid == request.auth.uid ||
        resource.data.driverUid == request.auth.uid
      );

      allow create: if request.auth != null
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.status == 'searching';

      allow update: if request.auth != null && (
        // le client annule sa propre demande tant qu'elle cherche un chauffeur
        (resource.data.clientUid == request.auth.uid
          && resource.data.status == 'searching'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        ||
        // un chauffeur accepte une demande encore ouverte
        (resource.data.status == 'searching'
          && request.resource.data.status == 'accepted'
          && request.resource.data.driverUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'driverUid', 'driverName']))
        ||
        // le chauffeur assigné termine ou annule la course acceptée
        (resource.data.status == 'accepted'
          && resource.data.driverUid == request.auth.uid
          && request.resource.data.status in ['completed', 'cancelled']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        ||
        // le client note le chauffeur une fois la course terminée
        (resource.data.status == 'completed'
          && resource.data.clientUid == request.auth.uid
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['rating', 'ratingComment', 'ratingPunctuality', 'ratingDriving', 'ratingCourtesy', 'ratingCleanliness']
          ))
        ||
        // le client paie sa course une fois celle-ci terminée
        (resource.data.status == 'completed'
          && resource.data.clientUid == request.auth.uid
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['paymentStatus', 'paymentMethod', 'paymentAmount', 'paymentDriverId']
          ))
      );

      allow delete: if false;

      // Messages échangés entre le client et le chauffeur assigné à cette
      // course : lisibles/écrivables uniquement par ces deux personnes.
      function isRideParty() {
        return get(/databases/$(database)/documents/ride_requests/$(requestId)).data.clientUid == request.auth.uid
          || get(/databases/$(database)/documents/ride_requests/$(requestId)).data.driverUid == request.auth.uid;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null && isRideParty();
        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && isRideParty();
        allow update, delete: if false;
      }
    }

    // Signalements (incidents/avis) envoyés par un client ou un chauffeur
    // depuis l'appli — traités uniquement côté admin (Admin SDK, qui
    // ignore ces règles). Un utilisateur ne voit que ses propres
    // signalements et ne peut jamais les modifier une fois envoyés.
    match /incidents/{incidentId} {
      allow read: if request.auth != null && resource.data.reporterUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open';

      allow update, delete: if false;
    }
  }
}
